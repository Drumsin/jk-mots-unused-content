JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,1,inline,<--- DON'T FORGET TO UPDATE THIS COUNT,MSGS 179,,keyword,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,3,full,"""<key>""     <unused number>   ""<string>""",,,keyword,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,6,full,Names of Levels,,,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,36,full,Objective descriptions,,,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,39,full,Level 1 - Nar Shaddaa - messages.,,,level_ref,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,41,inline,Goal 0,"""GOAL_01000""   0  ""Find 8t88 before he escapes with your father's data disc.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,47,full,Level 2 - Nar Shaddaa - messages.,,,level_ref,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,49,inline,Goal 0,"""GOAL_02000""   0  ""Recover your father's data disk from the clutches of 8t88's severed arm.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,50,inline,Goal 1,"""GOAL_02001""   0  ""Clear out the three-eyed Grans to create a safe landing zone for the Crow.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,51,inline,Goal 2,"""GOAL_02002""   0  ""Work your way to the top of Nar Shaddaa. From there Jan Ors will pick you up in the Crow.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,57,full,Level 3 - Morgan's House - messages.,,,level_ref,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,59,inline,Goal 0,"""GOAL_03000""   0  ""Find your way into your father's home to look for Weegee, the family droid.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,60,inline,Goal 1,"""GOAL_03001""   0  ""Go through the house, around back and through your father's natural power generator.  Watch your step near the pools of battery acid.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,61,inline,Goal 2,"""GOAL_03002""   0  ""Locate your father's workshop.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,67,full,Level 4 - Escape Morgan's House - messages.,,,level_ref,,C1,Likely rename
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,69,inline,Goal 0,"""GOAL_04000""   0  ""Use the aqueducts and irrigation channels behind the house to make your way to the water purification plant.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,70,inline,Goal 1,"""GOAL_04001""   0  ""Raise the water level inside the purification plant so you can proceed to the river dam.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,71,inline,Goal 2,"""GOAL_04002""   0  ""Find the passage to the river dam.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,72,inline,Goal 3,"""GOAL_04003""   0  ""Beyond the dam is your rendezvous point with Jan. Once there, you'll be paying 8t88 a visit, in the city of Barons Hed.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,78,full,Level 6a - Barons Hed - messages.,,,level_ref,,C1,Likely rename
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,80,inline,Goal 0,"""GOAL_06000""   0  ""Follow the canal into the besieged city of Barons Hed.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,81,inline,Goal 1,"""GOAL_06001""   0  ""Jerec's palace is heavily guarded and blocked off by high walls. Find your way inside those barriers.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,87,full,Level 6b - Barons Hed - messages.,,,level_ref,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,89,inline,Goal 0,"""GOAL_06500""   0  ""Find a route through the ruins to the palace tower.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,90,inline,Goal 1,"""GOAL_06501""   0  ""Gain entry into the tower via the upper plaza deck.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,91,inline,Goal 2,"""GOAL_06502""   0  ""Locate the primary bulkhead doors protecting the main entrance.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,92,inline,Goal 3,"""GOAL_06503""   0  ""Find a way into the control room above the inner door.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,93,inline,Goal 4,"""GOAL_06504""   0  ""Once the inner door is open, fight your way past the guards in the main anteroom, and find passage to the top of the palace.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,98,full,Level 7 - Yun - messages.,,,level_ref,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,100,inline,Goal 0,"""GOAL_07000""   0  ""Exercise the Force and defeat Yun. This is the test of a true Jedi.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,106,full,Level 8 - Escape the Ballroom - messages.,,,level_ref,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,108,inline,Goal 0,"""GOAL_08000""   0  ""Escape from the ballroom to the palace rooftop.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,109,inline,Goal 1,"""GOAL_08001""   0  ""On the roof of the palace a slight misstep means a certain end. Use the air ducts to gain entrance back into the tower and track down 8t88.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,110,inline,Goal 2,"""GOAL_08002""   0  ""Find 8t88's shuttle by using the palace ventilation system to cross to the far tower.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,115,full,Level 9 - Fuel Station - messages.,,,level_ref,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,117,inline,Goal 0,"""GOAL_09000""   0  ""The cargo ship is about to debark for the Valley of the Jedi with 8t88 on board. Get off the rooftops and into the fueling station.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,118,inline,Goal 1,"""GOAL_09001""   0  ""Once inside, drain the primary fuel tank and pass through it.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,119,inline,Goal 2,"""GOAL_09002""   0  ""The shortest route to the refueling gantry is through the fuel pipes themselves. Shut down the fuel flow to empty out the pipes.""",,,,,
JK,Episode\JK1.GOB,misc/cogstrings.uni,uni,120,inline,Goal 3,"""GOAL_09003""   0  ""Sneak through the fuel pipes to the reservoir under the cargo ship.""",,,,,
