MotS,Episode\JKM.GOO,misc/cogstrings.uni,uni,4,full,Names of Levels,,,,,,
MotS,Episode\JKM.GOO,misc/cogstrings.uni,uni,26,full,"""GOAL_00000""   0 "".""                 # Goal 0",,,,,,
MotS,Episode\JKM.GOO,misc/cogstrings.uni,uni,27,full,"""GOAL_00001""   0 "".""                 # Goal 1",,,,,,
MotS,Episode\JKM.GOO,misc/cogstrings.uni,uni,28,full,"""GOAL_00002""   0 "".""                 # Goal 2",,,,,,
MotS,Episode\JKM.GOO,misc/cogstrings.uni,uni,31,full,"Scenario 1, Level 1 - messages.",,,level_ref,,,
MotS,Episode\JKM.GOO,misc/cogstrings.uni,uni,33,inline,Goal 0,"""GOAL_01000""   0  ""Help the New Republic Soldiers repel the invading Imperial troops and then get back to Ops.""",,,,,
MotS,Episode\JKM.GOO,misc/cogstrings.uni,uni,34,inline,Goal 1,"""GOAL_01001""   0  ""Switch Comm Station over to auxiliary power to start jamming Imperial Communications for your escape.""",,,,,
MotS,Episode\JKM.GOO,misc/cogstrings.uni,uni,35,inline,Goal 2,"""GOAL_01002""   0  ""Bypass the Imperials and make your way to the Lambda Class shuttle.""",,,,,
MotS,Episode\JKM.GOO,misc/cogstrings.uni,uni,38,full,"""S1L1_REBELBASE_TEXT_01""   0  """"",,,level_ref,,,
MotS,Episode\JKM.GOO,misc/cogstrings.uni,uni,41,full,"Scenario 1, Level 2 - messages.",,,level_ref,,,
MotS,Episode\JKM.GOO,misc/cogstrings.uni,uni,43,inline,Goal 0,"""GOAL_02000""   0  ""Gain entry to the Security Check Point in the asteriod caves.""",,,,,
MotS,Episode\JKM.GOO,misc/cogstrings.uni,uni,44,inline,Goal 1,"""GOAL_02001""   0  ""Identify an auxiliary entrance to the Imperial facility.""",,,,,
MotS,Episode\JKM.GOO,misc/cogstrings.uni,uni,45,inline,Goal 2,"""GOAL_02002""   0  ""Find a way to disable the auxiliary door from outside of the security perimeter to gain entry into the facility.""",,,,,
MotS,Episode\JKM.GOO,misc/cogstrings.uni,uni,46,inline,Goal 3,"""GOAL_02003""   0  ""Once inside the Imperial facility, make your way down to the asteroid's core.""",,,,,
MotS,Episode\JKM.GOO,misc/cogstrings.uni,uni,52,full,"Scenario 1, Level 3 - messages.",,,level_ref,,,
MotS,Episode\JKM.GOO,misc/cogstrings.uni,uni,54,inline,Goal 0,"""GOAL_03000""   0  ""Circumvent the security system and gain access to the firing control room.""",,,,,
MotS,Episode\JKM.GOO,misc/cogstrings.uni,uni,55,inline,Goal 1,"""GOAL_03001""   0  ""Increase weapon power to maximum.""",,,,,
MotS,Episode\JKM.GOO,misc/cogstrings.uni,uni,56,inline,Goal 2,"""GOAL_03002""   0  ""Target Imperial asteroid and destroy it.""",,,,,
MotS,Episode\JKM.GOO,misc/cogstrings.uni,uni,61,full,"Scenario 1, Level 4 - messages.",,,level_ref,,,
MotS,Episode\JKM.GOO,misc/cogstrings.uni,uni,63,inline,Goal 0,"""GOAL_04000""   0  ""Circumvent the weapon's cooling system by destroying 5 of its cooling modules.""",,,,,
MotS,Episode\JKM.GOO,misc/cogstrings.uni,uni,64,inline,Goal 1,"""GOAL_04001""   0  ""Escape the asteriod before it self-destructs.""",,,,,
MotS,Episode\JKM.GOO,misc/cogstrings.uni,uni,69,full,"Scenario 2, Level 1 - messages.",,,level_ref,,,
